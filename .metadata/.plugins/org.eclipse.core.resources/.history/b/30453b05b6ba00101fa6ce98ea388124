<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	
	<!-- tO Enable @AutoWiring Annotation -->
	 <bean class="org.springframework.beans.factory.annotation.AutowiredAnnotationBeanPostProcessor"></bean>
	
	
	<!-- Student New Bean  -->
	 <bean id="studentNew" class="com.example.model.StudentModelData" >
	 	<property name="id" value="50001"></property>
	 	<property name="name" value="Shreya"></property>
	 </bean>
	 
	 <bean id ="address" class="com.example.model.Address">
	 	<property name="city" value="Nagpur"></property>
	 	<property name="state" value="Maharastra"></property>
	 </bean>
	 <bean id ="addMumbai" class="com.example.model.Address">
	 	<property name="city" value="Mumbai"></property>
	 	<property name="state" value="Maharastra"></property>
	 </bean>
	 <bean id ="addpune" class="com.example.model.Address">
	 	<property name="city" value="Pune"></property>
	 	<property name="state" value="Maharastra"></property>
	 </bean>
</beans>