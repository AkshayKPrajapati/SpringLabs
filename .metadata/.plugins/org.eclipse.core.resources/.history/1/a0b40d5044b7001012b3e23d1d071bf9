package com.example.core;

public class Student {
	
	int id;
	String name;
	
	
	
	@Override
	public String toString() {
		return "Student [id=" + id + ", name=" + name + "]";
	}
	
	public static void main(String[] args) {
		
		Student student = new  Student();
		student.id=101;
		student.name="Naina";
		
		System.out.println(student);
	}
}
