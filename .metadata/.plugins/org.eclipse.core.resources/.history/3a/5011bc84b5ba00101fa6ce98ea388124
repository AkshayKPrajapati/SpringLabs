package com.example.model;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Qualifier;

/*
 * Model class of the Student Class
 */
public class StudentModelData {
	int id;
	String name ;
	
	@Autowired
	@Qualifier("addMumbai")
	Address address; //Secondary Dependency
	public int getId() {
		return id;
	}
	public void setId(int id) {
		this.id = id;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public Address getAddress() {
		return address;
	}
	public void setAddress(Address address) {
		this.address = address;
	}
	public StudentModelData(int id, String name, Address address) {
		super();
		this.id = id;
		this.name = name;
		this.address = address;
	}
	@Override
	public String toString() {
		return "StudentNew [id=" + id + ", name=" + name + ", address=" + address + "]";
	}
	public StudentModelData() {
		super();
	}
	
	
	
}
