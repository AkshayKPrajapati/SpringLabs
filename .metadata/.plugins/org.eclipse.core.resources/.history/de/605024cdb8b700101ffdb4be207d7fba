package com.example.client;

import org.springframework.context.ApplicationContext;
import org.springframework.context.support.ClassPathXmlApplicationContext;

import com.example.model.Empolyee;

public class SpringBeanScope {
	public static String scopeBeanFile="com/example/bean/scope.xml";
	
	public static void main(String[] args) {
		
		ApplicationContext applicationContext=new ClassPathXmlApplicationContext(scopeBeanFile);
		Empolyee empolyee=(Empolyee) applicationContext.getBean("employee");
		System.out.println(empolyee);
		
	}
}
