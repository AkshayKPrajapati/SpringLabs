<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	<bean id="student" class="com.example.model.StudentData">
		<property name="marks">
			<list>
				<value>80</value>
				<value>90</value>
				<value>85</value>
			</list>	
		</property>
		<property name="subject">
			<set>
				<value>Math</value>
				<value>Science</value>
				<value>English</value>
			</set>
		</property>
		<property name="department">
			<map>
				<entry key="101" value="IT"></entry>
				<entry key="102" value="Computer"></entry>
				<entry key="103" value="Lab"></entry>
				<entry key="103" value="Admission"></entry>
			</map>
		</property>
	</bean>
</beans>