<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	<!-- Address Class Bean  -->
	 <bean id ="address" class="com.example.model.Address">
	 	<constructor-arg name="city" value="Ranchi"></constructor-arg>
	 	<constructor-arg name="state" value="Jharkhand"></constructor-arg>
	 </bean>
	 
	 <!-- Student New Bean  -->
	 <bean id="studentNew" class="com.example.model.StudentNew" autowire="constructor">
	 	<constructor-arg name="id" value="58036"></constructor-arg>
	 	<constructor-arg name="name" value="Aman"></constructor-arg>
	 </bean>
	
</beans>